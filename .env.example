# Copy to .env to override defaults (never commit .env with secrets).
OLLAMA_PORT=11434
WEBUI_PORT=3000
# Only for multi-GPU hosts: uncomment to pin a card, e.g. level_zero:1.
# Single-GPU setups must leave this unset.
# ONEAPI_DEVICE_SELECTOR=level_zero:1
OLLAMA_NUM_PARALLEL=1
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=10m
OLLAMA_ORIGINS=*
